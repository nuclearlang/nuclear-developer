{
  "components": {
    "schemas": {
      "Analysis": {
        "description": "The strategy of a request (ADR-0105) and what it asks of the run: the stages that run, the generator calls (the arguments of `dragonfly gen`, each accepted by its dry run), the pieces the tools already gave (a piece with `code` is written as it is) and the facts the request lacks.",
        "properties": {
          "generate": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "lead": {
            "description": "local, or frontier when the strategy needs a model that understands several files at once",
            "type": "string"
          },
          "limits": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "mode": {
            "description": "write, repair, verify, review, answer, commands or lead",
            "type": "string"
          },
          "pieces": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "report": {
            "type": "string"
          },
          "source": {
            "description": "where the pieces come from: plan (the planner splits what is left), declaring, naming or none",
            "type": "string"
          },
          "stages": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "strategy": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "trace": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "strategy",
          "title",
          "why",
          "mode",
          "stages",
          "lead",
          "source",
          "generate",
          "pieces",
          "questions",
          "limits",
          "report",
          "trace"
        ],
        "type": "object"
      },
      "AnalyzeRequest": {
        "description": "A request to analyse before a run: which kind of request it is.",
        "properties": {
          "platform": {
            "default": "backend",
            "type": "string"
          },
          "root": {
            "default": "",
            "description": "the project's folder: with it the analyst knows which names of the request the project has",
            "type": "string"
          },
          "spec": {
            "minLength": 3,
            "type": "string"
          },
          "strategy": {
            "default": "",
            "description": "the strategy the request itself names (`usecase`), when it names one",
            "type": "string"
          }
        },
        "required": [
          "spec"
        ],
        "type": "object"
      },
      "ChatRequest": {
        "description": "A message to the local assistant, with what it needs to answer about the project.",
        "properties": {
          "history": {
            "default": "",
            "description": "the last messages of the session, oldest first, as `you: ...` / `agent: ...` lines",
            "type": "string"
          },
          "map": {
            "default": "",
            "description": "the project's map (.nuclear/map.md): every declaration with its kind, description and members",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "platform": {
            "default": "backend",
            "description": "backend, mobile or web",
            "type": "string"
          },
          "root": {
            "default": "",
            "description": "the project's folder: with it the assistant reads the files that declare the names the question writes",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "PieceReply": {
        "description": "What an agent answers: the code (or the review), its check and what it did, step by step.",
        "properties": {
          "attempts": {
            "type": "integer"
          },
          "check": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "report": {
            "type": "string"
          },
          "trace": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "report",
          "check",
          "attempts",
          "trace"
        ],
        "type": "object"
      },
      "PieceRequest": {
        "description": "One piece of work for a local agent: ONE file, named as precisely as possible.",
        "properties": {
          "context": {
            "default": "",
            "type": "string"
          },
          "kind": {
            "default": "",
            "type": "string"
          },
          "path": {
            "default": "",
            "type": "string"
          },
          "platform": {
            "default": "backend",
            "description": "backend, mobile or web: the agents write Nuclear for a platform, never for a dialect",
            "type": "string"
          },
          "root": {
            "default": "",
            "description": "the project's folder: with it an agent reads by itself the files that declare the names its task writes",
            "type": "string"
          },
          "task": {
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      },
      "PlanReply": {
        "description": "The pieces of a plan, in the order they can be written; the same plan as a tree (the big parts, their tasks, the pieces of each); and what of the spec is beyond the platform or the local agents, for the user to know.",
        "properties": {
          "limits": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pieces": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array"
          },
          "raw": {
            "type": "string"
          },
          "trace": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array"
          },
          "tree": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "pieces",
          "raw",
          "trace",
          "limits"
        ],
        "type": "object"
      },
      "PlanRequest": {
        "description": "A spec to split into pieces.",
        "properties": {
          "platform": {
            "default": "backend",
            "description": "backend, mobile or web: the agents write Nuclear for a platform, never for a dialect",
            "type": "string"
          },
          "root": {
            "default": "",
            "description": "the project's folder: what it already declares is not planned again, and new pieces go to its components",
            "type": "string"
          },
          "spec": {
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "spec"
        ],
        "type": "object"
      },
      "Recall": {
        "description": "What the Nuclear Smart Graph gave an agent for a task.",
        "properties": {
          "examples": {
            "type": "string"
          },
          "guide": {
            "type": "string"
          },
          "knowledge": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "guide",
          "knowledge",
          "examples",
          "note"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "nuclear_developer",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/developer/accept": {
      "post": {
        "operationId": "DeveloperController.accept",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PieceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PieceReply"
                }
              }
            },
            "description": "ok"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "the error of the use case"
          }
        },
        "summary": "Each acceptance criterion held against what a run left: `task` the criteria, numbered; `context` the facts and the files of the run.",
        "tags": [
          "developer"
        ]
      }
    },

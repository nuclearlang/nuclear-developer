          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "the error of the use case"
          }
        },
        "summary": "Which kind of request a spec is and what its strategy asks of the run: before anything is generated or planned.",
        "tags": [
          "developer"
        ]
      }
    },

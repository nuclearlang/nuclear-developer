// The coder: writes one .nuc file from a precise task, with the card of the kind it writes, the mistakes to avoid
// with that kind and validated examples of it (all from the graph), and repairs it with the card of each error the
// compiler reports until `nuclear check` reports none. Prompts: agents/piece.md, agents/repair.md.
@state(PieceState)
graph Coder(bench: Workbench)
  @start
  @next("write")
  recall(state: PieceState) <string, any>
    found = ~bench.recall("${state.kind} ${state.task}", state.platform, "piece", kind = state.kind)
    detail = if found.note.length > 0
      found.note
    else
      "${found.knowledge.length} characters of knowledge, ${found.examples.length} of examples"
    // the files the piece depends on: what the caller pasted, and what the project itself declares of the task's names
    own = bench.files(state.root, state.task, skip = state.path, have = state.context)
    context = bench.sections([state.context, own])
    { "guide": found.guide, "knowledge": found.knowledge, "examples": found.examples, "context": context, "trace": state.trace + [bench.step("recall", detail)] }

  @next("end")
  write(state: PieceState) <string, any>
    done = ~bench.write(state, ~bench.compose(state), 3, faithful = true)
    { "code": done.code, "report": "", "check": done.check, "attempts": done.attempts, "trace": done.trace }

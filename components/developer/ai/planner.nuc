// The planner: splits a spec into pieces of one file each, in the order they can be written (the local plan when no
// frontier model leads the work). The model names each piece's kind, declaration, component and screen; its path
// comes from the platform's layout (`nuclear help layout`), so a small model never guesses a folder. Prompts:
// agents/plan.md, agents/plan-again.md.
@state(PieceState)
graph Planner(bench: Workbench, toolchain: Toolchain)
  @start
  @next("split")
  recall(state: PieceState) <string, any>
    found = ~bench.recall("project structure components kinds ${state.task}", state.platform, "plan")
    layout = ~toolchain.help("layout", state.platform)
    // what of the spec is beyond the platform (the graph's capabilities whose trigger words the spec writes) or beyond
    // a local model (a spec longer than it reads at once)
    limits: string[] = ~bench.knowledge.applies(state.task, state.platform)
    if state.task.length > 6000
      limits.add(~bench.knowledge.brief("limit:agent-context"))
    { "guide": found.guide, "knowledge": "${layout}\n\n${found.knowledge}", "limits": limits, "trace": state.trace + [bench.step("recall", "the plan guide, the platform's layout (nuclear help layout) and the cards — ${bench.read(found.knowledge)}")] + limits.map((l) => bench.step("limit", l)) }

  @next("end")
  split(state: PieceState) <string, any>
    prompt = ~bench.prompt("plan", { "guide": state.guide, "knowledge": state.knowledge, "task": state.task })
    raw = ~bench.ask("default", prompt)
    declared: <string, string> = {}
    if state.root.length > 0
      declared = Workspace(state.root).declarations()
    planned = ~pieces(raw, state.platform, state.task, declared)
    if planned.length == 0
      raw = ~bench.ask("default", ~bench.prompt("plan-again", { "prompt": prompt, "answer": raw }))
      planned = ~pieces(raw, state.platform, state.task, declared)
    limits = state.limits
    if planned.length == 0
      limits = limits + [~bench.knowledge.brief("failure:the-plan-has-no-pieces")]
    else if planned.length > 12
      limits = limits + [~bench.knowledge.brief("limit:agent-features")]
    shown = tree(planned)
    report = bench.sections([raw, shown.length > 0 ? "The plan: its parts (a component), their tasks (a layer) and their pieces (a file)\n\n${shown}" : "", limits.length > 0 ? "Beyond the platform or the local agents (tell the user)\n\n${limits.map((l) => "- ${l}").join("\n")}" : ""])
    { "pieces": planned, "report": report, "tree": shown, "limits": limits, "trace": state.trace + [bench.step("split", "${planned.length} pieces")] }

  // The plan as a tree: the big parts (one per component), the tasks of each (a layer: data, domain, the facade, the
  // entry points, the tests) and the pieces of each task (one file), in the order the layers are written.
  tree(pieces: <string, string>[]) string
    order = ["configuration", "data", "domain", "facade", "api", "events", "ai", "screens", "tests", "app"]
    parts: string[] = []
    for piece in pieces
      part = partOf(piece["path"]!)
      if not (part in parts)
        parts.add(part)
    lines: string[] = []
    for part in parts
      lines.add(part)
      for layer in order
        mine = pieces.filter((p) => partOf(p["path"]!) == part and layerOf(p["path"]!) == layer)
        if mine.length > 0
          lines.add("  ${layer}")
          for piece in mine
            lines.add("    - ${piece["kind"]!} → ${piece["path"]!}")
    lines.join("\n")

  // The big part a file belongs to: its component, the tests, or the app itself.
  partOf(path: string) string
    cells = path.split("/")
    if cells[0] == "components" and cells.length > 2
      return cells[1]
    "test" in cells[0] ? "tests" : "app"

  // The task a file belongs to inside its part: the layer its folder says.
  layerOf(path: string) string
    rules = [["test/", "tests"], ["/data/", "data"], ["/domain/", "domain"], ["/api/", "api"], ["/presentation/", "screens"], ["/ai/", "ai"], ["/events/", "events"], ["config", "configuration"], ["component.nuc", "facade"]]
    for rule in rules
      if rule[0] in path
        return rule[1]
    "app"

  // The lines `kind | Name | component | screen | what` → pieces with the layout's path. A small model may move the
  // columns: the kind is the cell the layout knows, the name the first one in PascalCase. Left out: a line without
  // both, a name already planned and, when the spec names its declarations, a name it does not (the planner splits
  // such a spec; it does not design more). A spec names a declaration with its kind's word before it ("a use case
  // CancelOrder") or with a name of two words or more (`CancelOrder`); a capitalised noun alone ("Character schema")
  // names none, so a spec in plain words keeps every line the model designed, but its tests: the Tests first stage
  // writes those from the acceptance criteria. A component that is not a plain name takes the one the other lines give.
  // Each piece's task ends with the spec's own sentence about it: the model's summary may lose a detail.
  // `declared`: what the project already has (name → file). A name of it the spec only uses (`repository:
  // BookRepository`) is not planned again; one the spec introduces with its kind's word ("a repository BookRepository
  // with...") is, as a change of its file. New pieces go to the component of the declarations the spec uses.
  pieces(raw: string, platform: string, spec: string, declared: <string, string> = {}) <string, string>[]
    layout: <string, string> = ~toolchain.layout(platform)
    plain = Regex(r"^[a-z][a-z0-9_]*$")
    pascal = Regex(r"^[A-Z][A-Za-z0-9]*$")
    rows: <string, string>[] = []
    components: string[] = []
    for line in raw.split("\n")
      cells = line.replaceAll("`", "").split("|").map((c) => c.trim())
      kinds = cells.filter((c) => c in layout)
      names = cells.filter((c) => pascal.test(c))
      if cells.length >= 3 and kinds.length > 0 and names.length > 0
        ordered = cells[0] == kinds[0] and cells.length >= 5
        component = ordered and plain.test(cells[2].lower()) ? cells[2].lower() : ""
        if component.length > 0
          components.add(component)
        screen = ordered and cells[3] != "-" ? cells[3] : ""
        what = ordered ? cells.slice(4).join("|").trim() : cells[cells.length - 1]
        rows.add({ "kind": kinds[0], "name": names[0], "component": component, "screen": screen, "what": what })
    // what the spec introduces with a kind word ("A model NewReader", "a use case AllBooks") is that kind: it corrects
    // the model's label and adds the pieces it forgot. How people write a kind ("application component", "use case")
    // comes from the graph's cards of the platform's kinds, and is read as the kind's own word
    said = spec
    introduced: string[] = []
    spoken: <string, string> = ~bench.knowledge.kinds(platform)
    for phrase, kind in spoken
      if " " in phrase
        said = said.replaceAll(Regex("\\b${phrase}\\b", ignoreCase = true), kind)
    for m in Regex(r"\b([a-z]+)(?:\s([a-z]+))?\s+([A-Z][A-Za-z0-9]*)").findAll(said)
      first = m[1] ?? ""
      second = m[2] ?? ""
      name = m[3] ?? ""
      // "a usecase X" → usecase; "the model X" → model; "appcomponent X" → appcomponent
      kind = "${first}${second}" in layout ? "${first}${second}" : second in layout and first in ["a", "an", "the"] ? second : first in layout and second.length == 0 ? first : ""
      if kind.length > 0 and name.length > 0
        introduced.add(name)
        same = rows.filter((r) => r["name"]! == name)
        if same.length == 0
          rows.add({ "kind": kind, "name": name, "component": "", "screen": "", "what": "" })
        for r in same
          r["kind"] = kind
    mentioned = Regex(r"\bcomponent\s+([a-z][a-z0-9_]*)").find(spec)
    plural = rows.length > 0 ? "${rows[0]["name"]!.lower()}s" : "app"
    fallback = components.length > 0 ? components[0] : mentioned != null ? mentioned![1] ?? plural : plural
    // the component the spec's work lives in: the one of a declaration of the project it uses
    home = ""
    for known, file in declared
      if home.length == 0 and file.startsWith("components/") and Regex("\\b${known}\\b").test(spec)
        home = file.split("/")[1]
    // the declarations the spec names: the ones it introduces, and every name of two words or more it writes
    written: string[] = introduced + []
    for m in Regex(r"\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\b").findAll(spec)
      written.add(m[0] ?? "")
    named = written.length > 0 ? rows.filter((r) => r["name"]! in spec) : []
    if named.length > 0
      // in the order the spec gives them: a spec lists what it builds on first
      rows = named
      rows.sortBy((r) => spec.indexOf(r["name"]!))
    else
      rows = rows.filter((r) => r["kind"]! != "tests")
    out: <string, string>[] = []
    planned: string[] = []
    for r in rows
      name = r["name"]!
      kind = r["kind"]!
      component = home.length > 0 ? home : r["component"]!.length > 0 ? r["component"]! : fallback
      path: string = ~toolchain.pathOf(platform, kind, name, component, r["screen"]!)
      if path.length > 0 and not (name in planned) and (not (name in declared) or name in introduced)
        planned.add(name)
        // the sentence that introduces it: the first one that names it as a word (`Book`, not `BookRepository`); later
        // ones only use it (`Result<BookError, Book[]>`) and would make the coder write their declarations too
        word = Regex("\\b${name}\\b")
        sentences = spec.split(". ").filter((x) => word.test(x))
        // a sentence of the spec is the piece's task only when the spec named the piece: the first mention of a
        // word of a spec in plain words is not about that file
        said = named.length > 0 and sentences.length > 0 ? sentences[0].trim() : ""
        // the spec's own sentence is the task; the model's summary only when the spec has none (a 2B summary turned
        // an alias `booksOf() = BooksOfAuthor.exec` into a method signature, and the coder followed it)
        task = said.length > 0 ? "${kind} ${name}. The spec says: ${said}" : "${kind} ${name}: ${r["what"]!}"
        out.add({ "path": path, "kind": kind, "task": task })
    out
